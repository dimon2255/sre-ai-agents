{
  "id": "GS-12",
  "title": "Disposed storage client leaves documents-api stuck after a network blip",
  "narrative": "Forty minutes ago a brief network interruption to Blob Storage caused documents-api's singleton storage client to dispose its pooled TLS stream. The client never rebuilds it, so every document download now throws ObjectDisposedException before any call leaves the process. Storage itself recovered immediately and is healthy. Nothing was deployed. Restarting the replicas recreates the client and ends the incident.",
  "tags": ["application", "pair:error-spike-restartable-vs-not", "pair:change-vs-no-change"],
  "alert": {
    "rule": "Http 5xx > 50 in 5 minutes",
    "severity": "Sev2",
    "signal_type": "Metric",
    "resource": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-documents-prod/providers/Microsoft.App/containerApps/documents-api"
  },
